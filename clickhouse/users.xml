<clickhouse>
  <!--
    La imagen stock limita el usuario `default` a loopback (127.0.0.1/::1) y
    rechaza conexiones desde los contenedores backend y order-worker. Este
    usuario de aplicación es alcanzable desde la red de Compose.
  -->
  <users>
    <shopify>
      <password>shopify</password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
    </shopify>
  </users>
</clickhouse>
